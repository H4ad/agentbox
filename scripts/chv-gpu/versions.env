# Every pin of the GPU spike, read by build.sh, the Dockerfile (as build
# arguments) and try.sh. Sources are pinned by git commit or SHA-256.

# Spectrum OS's GPU patchset for Cloud Hypervisor: their newest, 50.0-spectrum0,
# which targets Cloud Hypervisor v50.0 and was tested with crosvm 18bc84d00.
# https://spectrum-os.org/software/cloud-hypervisor/
SPECTRUM_PATCHES_URL=https://spectrum-os.org/software/cloud-hypervisor/cloud-hypervisor-50.0-spectrum0-patches.tar.gz
SPECTRUM_PATCHES_SHA256=b495216f460e34acd26a83890086d3912672a368325c48e1a6febdb3afac98bc

CHV_VERSION=50.0
CHV_URL=https://github.com/cloud-hypervisor/cloud-hypervisor/archive/refs/tags/v50.0.tar.gz
CHV_SHA256=19bfef37076bc8144ad45c54c65aa2b28b22426f1ffddd69118ff663b35f8d7b

# rust-vmm's vhost crates, which the patchset replaces with a patched local copy.
VHOST_TAG=vhost-user-backend-v0.20.0
VHOST_URL=https://github.com/rust-vmm/vhost/archive/refs/tags/vhost-user-backend-v0.20.0.tar.gz
VHOST_SHA256=fb2a1ff45408c2e424487fe5eb73d6cdf1f1072371b009406325045c7ca2806e

# crosvm has no releases: the commit Spectrum tested, and the minijail
# submodule it pins (the other submodules aren't needed to build it). Both
# come from googlesource, or from Google's GitHub mirrors when googlesource
# keeps failing; the commit is checked either way.
CROSVM_REPO=https://chromium.googlesource.com/crosvm/crosvm
CROSVM_MIRROR=https://github.com/google/crosvm
CROSVM_COMMIT=18bc84d003e04108d973a5233f0c6f3b2039d756
MINIJAIL_REPO=https://chromium.googlesource.com/chromiumos/platform/minijail
MINIJAIL_MIRROR=https://github.com/google/minijail
MINIJAIL_COMMIT=bfd22f25fd2302fe4ae5121d80c836e0f124e742

VIRGLRENDERER_VERSION=1.2.0
VIRGLRENDERER_REPO=https://gitlab.freedesktop.org/virgl/virglrenderer.git
VIRGLRENDERER_COMMIT=500b41d5c8638f9b80dd558f4044f3301c7457a4

# The build environment: Rust 1.88.0 (crosvm's rust-toolchain) on Debian 12,
# whose glibc (2.36) is old enough for most hosts, with its packages frozen at
# one snapshot.debian.org date.
RUST_IMAGE=rust:1.88.0-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89
DEBIAN_SNAPSHOT=20261015T000000Z
# 2026-10-15 00:00:00 UTC: the tarball's file times.
SOURCE_DATE_EPOCH=1792022400

# The guest, for try.sh: Debian 13's generic image (the cloud image's kernel
# has no virtio_gpu), the same build AgentBox's VM uses, and the UEFI
# firmware Cloud Hypervisor v50's own integration tests boot
# (scripts/test-util.sh; its SHA-1 is in v50's scripts/sha1sums-x86_64), not
# the newer one AgentBox's v53 VM uses.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20260914-2601/debian-13-generic-amd64-20260914-2601.tar.xz
DEBIAN_IMAGE_SHA512=40017fab9e1ed4bd3d2068e49301ac8427d02c2ee418160bdedd041f529e048fa0dc8ddf8f363e85bdb3c33e9f3cf4c5734d98429ba6802bbc4d4a83df7f0f4b
FIRMWARE_URL=https://github.com/cloud-hypervisor/edk2/releases/download/ch-a54f262b09/CLOUDHV.fd
FIRMWARE_SHA256=0624c06c5d07cb8efe38806890ce7076c41c0902f2fcd5b2376f107033e3222b
PASST_URL=https://passt.top/builds/latest/x86_64/passt
